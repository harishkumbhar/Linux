---
- name: Standardize fstab configuration for /tmp and /var/tmp
  hosts: all
  become: true
  tasks:
    - name: Ensure /dev/mapper/rhel-tmp has noexec options
      ansible.posix.mount:
        path: /tmp
        src: /dev/mapper/rhel-tmp
        fstype: xfs
        opts: defaults,nodev,nosuid,noexec
        state: present

    - name: Remove bind mount line for /var/tmp
      ansible.posix.mount:
        path: /var/tmp
        state: absent

