def analyze_oc_command(user_input: str):
    clean_input = user_input.strip()
    tokens = clean_input.split()

    if not tokens:
        print("Error: No command entered.")
        return

    # Strip 'oc' if provided at start
    if tokens[0].lower() == "oc":
        tokens = tokens[1:]

    if not tokens:
        print("Entered only 'oc'. OpenShift CLI binary base command.")
        return

    main_subcommand = tokens[0].lower()
    
    # Handle composite subcommands (e.g. "config view", "config use-context")
    full_subcommand = main_subcommand
    if len(tokens) > 1 and f"{main_subcommand} {tokens[1].lower()}" in [
        "config view", "config current-context", "config use-context"
    ]:
        full_subcommand = f"{main_subcommand} {tokens[1].lower()}"

    resource_or_flag = tokens[1:] if len(tokens) > 1 else []

    print("\n" + "="*65)
    print(f" 🔍 OCP Command Analysis: '{clean_input}'")
    print("="*65)

    if main_subcommand in COMMAND_KNOWLEDGE_BASE:
        info = COMMAND_KNOWLEDGE_BASE[main_subcommand]
        
        print("\n📌 PURPOSE:")
        print(f"   {info['purpose']}")

        if resource_or_flag:
            target = " ".join(resource_or_flag)
            print(f"\n🎯 TARGET / ARGUMENTS SPECIFIED:")
            print(f"   You specified target/flags: '{target}'")
            if main_subcommand == "get":
                print(f"   --> This will list and retrieve current details about: '{target}'.")

        print("\n💡 EXAMPLES & USAGE VARIATIONS:")
        for idx, ex in enumerate(info["examples"], 1):
            print(f"   {idx}. {ex}")

    else:
        print("\n📌 PURPOSE:")
        print(f"   Custom or advanced command under 'oc {main_subcommand}'.")
        print("   TIP: You can get official embedded help by running:")
        print(f"   --> oc {main_subcommand} --help")
        print(f"   --> oc explain {main_subcommand}")

    print("\n" + "="*65 + "\n")


def main():
    print("=== OpenShift (OCP) Command Explainer ===")
    print("Type your OCP command below (e.g., 'oc get nodes', 'oc new-app', 'oc status').")
    print("Type 'exit' or 'quit' to close.\n")

    while True:
        try:
            cmd = input("Enter OCP Command > ")
            if cmd.strip().lower() in ["exit", "quit"]:
                print("Exiting tool. Goodbye!")
                break
            if cmd.strip():
                analyze_oc_command(cmd)
        except (KeyboardInterrupt, EOFError):
            print("\nExiting tool.")
            break

if __name__ == "__main__":
    main()

